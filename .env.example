# Copy to .env for local use. On a host, set these as environment variables / secrets instead.

NODE_ENV=production
PORT=3000

# REQUIRED: PostgreSQL connection string (Neon, Supabase, Render Postgres, or your own).
# Example: postgres://user:password@host/dbname?sslmode=require
DATABASE_URL=

# REQUIRED: scrypt hash of the admin password. Generate with:  npm run hash
ADMIN_PASSWORD_HASH=

# Alternative to the hash (hashed in memory at startup). Prefer ADMIN_PASSWORD_HASH.
# ADMIN_PASSWORD=

# Set to 1 when running behind a reverse proxy / PaaS (Render, Railway, Fly, Caddy, nginx)
# so rate limits and lockouts see each visitor's real address.
TRUST_PROXY=1

# Voting state the very first time the database is created: open (default) or closed.
VOTING_DEFAULT=open
